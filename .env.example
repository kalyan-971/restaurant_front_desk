# Copy to .env for local runs. On Render, add these under Environment instead.
# Never commit the real .env file.

PUBLIC_BASE_URL=https://your-app.onrender.com

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your-twilio-auth-token

ANTHROPIC_API_KEY=your-api-key
AI_MODEL=claude-haiku-5-5

# Password for the staff screen (username can be anything)
STAFF_PASSWORD=change-me

# Leave true in production. Set false only to test locally without Twilio.
VALIDATE_TWILIO=true
